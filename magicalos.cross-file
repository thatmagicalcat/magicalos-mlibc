[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
strip = 'llvm-strip'
pkgconfig = 'pkg-config'

[built-in options]
c_args = ['--target=x86_64-unknown-none']
cpp_args = ['--target=x86_64-unknown-none']

c_link_args = ['--target=x86_64-unknown-none', '-fuse-ld=lld', '--rtlib=compiler-rt']
cpp_link_args = ['--target=x86_64-unknown-none', '-fuse-ld=lld', '--rtlib=compiler-rt']

[host_machine]
system = 'magicalos'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
